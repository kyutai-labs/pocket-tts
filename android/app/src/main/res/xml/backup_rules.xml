<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older. Backup is opt-out by path here, so the model is named
    and everything else travels.
-->
<full-backup-content>
    <!--
        A model is 47 to 219 MB and can be downloaded again. Cloud backup allows
        an app 25 MB, so including one does not make a partial backup - it makes
        a failed one, taking the settings and the voices down with it. Every
        model lives under pocket-tts/models; the other two paths are retired
        models an upgraded install deletes on its first load.
    -->
    <exclude domain="file" path="pocket-tts/sherpa-onnx-pocket-tts-int8-2026-01-26" />
    <exclude domain="file" path="pocket-tts/models" />
        <exclude domain="file" path="pocket-tts/english_2026-04" />
</full-backup-content>
