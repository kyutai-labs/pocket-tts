<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        hasFragileUserData asks, on uninstall, whether to keep the app's data.
        Everything this app has lives in internal storage, so uninstalling threw
        away a 200 MB download and - far worse - every voice the user had
        recorded or imported, which exists nowhere else. The dialog is the only
        way to offer that choice.
    -->
    <application
        android:name=".PocketTtsApp"
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketTts">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The PROCESS_TEXT filter is what puts "Read aloud" into the tap-and-hold
            text selection toolbar in other apps. The label is deliberately short:
            the floating toolbar truncates anything longer.
        -->
        <activity
            android:name=".ui.ReadAloudActivity"
            android:exported="true"
            android:label="@string/read_aloud"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PocketTts.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share-sheet entry, for apps whose selection toolbar is custom-drawn. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ScratchpadActivity"
            android:exported="true"
            android:label="@string/scratchpad"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppearanceActivity"
            android:exported="false"
            android:label="@string/appearance" />

        <activity
            android:name=".ui.VoicePickerActivity"
            android:exported="false"
            android:label="@string/voices" />

        <activity
            android:name=".ui.ModelPickerActivity"
            android:exported="false"
            android:label="@string/models" />

        <!--
            Registering as a system TTS engine means every app that already knows how
            to read text aloud - Select to Speak, Chrome's read aloud, ebook readers -
            can use these voices without knowing anything about this app.
        -->
        <service
            android:name=".engine.PocketTtsService"
            android:exported="true"
            android:label="@string/engine_name"
            android:permission="android.permission.BIND_TEXT_TO_SPEECH_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Exported so a coding agent on this phone can hand a finished reply
            straight to the reader, with the screen off - which is the one thing
            ReadAloudActivity cannot do, since an activity start needs a
            foreground caller.

            The caller is a different app, so there is no signature-level
            permission to hold this behind: a signature check would only ever
            admit apps signed with this app's key, and the whole point is the
            ones that are not. So the trade, plainly: any app on the device can
            make this one start reading, replace what it is reading, or read out
            any file this app can open. Nothing comes back - there is no result,
            no broadcast out, no way to hear what was read except by being in
            the room - so it is a nuisance rather than a leak, but it is a real
            one and it is the price of the feature.

            No intent-filter, deliberately. An exported receiver with no filter
            is reachable only by explicit component, so it never appears as a
            candidate for somebody else's implicit broadcast.

            PlaybackService stays unexported. This is the front door; the
            service behind it is nobody else's business.
        -->
        <receiver
            android:name=".SpeakReceiver"
            android:exported="true" />

    </application>
</manifest>
